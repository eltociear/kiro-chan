{
  "name": "kiro-chan",
  "displayName": "Kiro-Chan",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {},
  "publisher": "your-publisher-id",
  "version": "1.0.0",
  "description": "Kiroのステータスバーに常駐するキャラクター拡張機能",
  "repository": "https://github.com/eltociear/kiro-chan.git",
  "license": "MIT",
  "author": "Kiro Status Character Extension Contributors",
  "keywords": [
    "kiro",
    "status-bar",
    "character",
    "animation",
    "productivity"
  ],
  "main": "dist/extension.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.102.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "testTimeout": 10000
  }
}
