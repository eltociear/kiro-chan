{
  "name": "kiro-chan",
  "displayName": "Kiro-Chan",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "kiro-chan.openSettings",
        "title": "Open Settings",
        "category": "Kiro Chan"
      },
      {
        "command": "kiro-chan.setIdle",
        "title": "Set Idle State",
        "category": "Kiro Chan"
      },
      {
        "command": "kiro-chan.setActive",
        "title": "Set Active State",
        "category": "Kiro Chan"
      },
      {
        "command": "kiro-chan.setError",
        "title": "Set Error State",
        "category": "Kiro Chan"
      }
    ],
    "configuration": {
      "title": "Kiro Chan",
      "properties": {
        "kiro-chan.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable the Kiro character in status bar"
        },
        "kiro-chan.animationSpeed": {
          "type": "number",
          "default": 1,
          "minimum": 0.1,
          "maximum": 3,
          "description": "Animation speed multiplier"
        }
      }
    }
  },
  "publisher": "eltociear",
  "version": "1.0.0",
  "description": "Kiroのステータスバーに常駐するキャラクター拡張機能",
  "repository": "https://github.com/eltociear/kiro-chan.git",
  "license": "MIT",
  "author": "Kiro Status Character Extension Contributors",
  "keywords": [
    "kiro",
    "status-bar",
    "character",
    "animation",
    "productivity"
  ],
  "main": "dist/extension.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.94.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "testTimeout": 10000
  }
}
