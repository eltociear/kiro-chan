{
  "name": "kiro-chan",
  "displayName": "Kiro-Chan",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "logo.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "icons": {
      "kiro-icon": {
        "description": "Kiro character icon",
        "default": {
          "fontPath": "./images/kiro_1.svg"
        }
      },
      "kiro-idle": {
        "description": "Kiro character in idle state",
        "default": {
          "fontPath": "./images/kiro_1.svg"
        }
      },
      "kiro-active": {
        "description": "Kiro character in active state",
        "default": {
          "fontPath": "./images/kiro_1.svg"
        }
      },
      "kiro-error": {
        "description": "Kiro character in error state",
        "default": {
          "fontPath": "./images/kiro_1.svg"
        }
      }
    },
    "commands": [
      {
        "command": "kiro-chan.openSettings",
        "title": "Open Settings",
        "category": "Kiro Chan"
      },
      {
        "command": "kiro-chan.setIdle",
        "title": "Set Idle State",
        "category": "Kiro Chan"
      },
      {
        "command": "kiro-chan.setActive",
        "title": "Set Active State",
        "category": "Kiro Chan"
      },
      {
        "command": "kiro-chan.setError",
        "title": "Set Error State",
        "category": "Kiro Chan"
      },
      {
        "command": "kiro-chan.taskCompleted",
        "title": "Task Completed",
        "category": "Kiro Chan"
      },
      {
        "command": "kiro-chan.testNotification",
        "title": "Test Notification & Sound",
        "category": "Kiro Chan"
      },
      {
        "command": "kiro-chan.testWorkSession",
        "title": "Test Work Session Complete",
        "category": "Kiro Chan"
      },
      {
        "command": "kiro-chan.testMilestone",
        "title": "Test Milestone Celebration",
        "category": "Kiro Chan"
      }
    ],
    "configuration": {
      "title": "Kiro Chan",
      "properties": {
        "kiro-chan.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable the Kiro character in status bar"
        },
        "kiro-chan.animationSpeed": {
          "type": "number",
          "default": 1,
          "minimum": 0.1,
          "maximum": 3,
          "description": "Animation speed multiplier"
        },
        "kiro-chan.notificationEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Show notification when Kiro task is completed"
        },
        "kiro-chan.soundEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Play sound when Kiro task is completed"
        },
        "kiro-chan.soundVolume": {
          "type": "number",
          "default": 0.5,
          "minimum": 0,
          "maximum": 1,
          "description": "Sound volume (0.0 to 1.0)"
        },
        "kiro-chan.useSvgIcon": {
          "type": "boolean",
          "default": true,
          "description": "Use SVG icon instead of emoji characters in the status bar"
        }
      }
    }
  },
  "publisher": "eltociear",
  "version": "1.0.0",
  "description": "Kiroのステータスバーに常駐するキャラクター拡張機能",
  "repository": "https://github.com/eltociear/kiro-chan.git",
  "license": "MIT",
  "author": "Kiro Status Character Extension Contributors",
  "keywords": [
    "kiro",
    "status-bar",
    "character",
    "animation",
    "productivity"
  ],
  "main": "dist/extension-simple.js",
  "files": [
    "dist/**/*",
    "images/**/*",
    "images/kiro_1.svg"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:svg-icon": "node ./test-svg-icon.js",
    "package": "node -r ./suppress-warnings.js -e \"require('child_process').execSync('npx vsce package', {stdio: 'inherit'})\"",
    "package-quiet": "node --no-warnings -r ./suppress-warnings.js -e \"require('child_process').execSync('npx vsce package', {stdio: 'inherit'})\""
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.94.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "testTimeout": 10000
  }
}
